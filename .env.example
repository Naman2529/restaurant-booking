# Copy to .env and fill in. .env is git-ignored; never commit real values.

# PostgreSQL superuser, used by psql to build the database (db/reset.sql)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=restaurant_booking

# Password for booking_app, the restricted role the API connects as.
# db/roles.sql sets it; the API reads it.
APP_DB_PASSWORD=change-me-too
# APP_DB_USER=booking_app

# API
HTTP_PORT=8080
# At least 32 random characters
JWT_SECRET=replace-with-at-least-32-random-characters
# Public URL of the front end; used in email verification links
APP_BASE_URL=http://localhost:5173
# true when served over HTTPS
COOKIE_SECURE=false

# Optional: Gmail address + app password for verification emails.
# Leave both unset and the links are printed to the API log instead.
# SMTP_USER=
# SMTP_PASSWORD=
